# Copy to .env and fill in. .env is gitignored and must never be committed.
# Nothing loads .env automatically yet — export these in your shell, or ask
# before adding python-dotenv.

# Required in production. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# "true" locally, "false" everywhere else.
DJANGO_DEBUG=true

# Comma-separated. Required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=
